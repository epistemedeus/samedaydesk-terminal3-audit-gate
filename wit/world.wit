/// SameDayDesk privacy-preserving AI search audit intake contract.
///
/// This world intentionally imports no host capabilities. The contract is a
/// deterministic policy boundary: it accepts a private prospect intake, emits
/// only an opaque id and a prioritized public-safe plan, and never returns the
/// prospect domain, contact email, budget, or internal notes.
package z:samedaydesk-audit@0.1.0;

world samedaydesk-audit {
    export contracts;
}

interface contracts {
    /// Standard 3-field envelope used by all contracts callable from the node.
    /// `input`        — JSON-serialized request payload specific to the function.
    /// `user-profile` — always None for tenant contracts (hardcoded at dispatch).
    /// `context`      — JSON-serialized DynamicContext (node-minted, trusted).
    record generic-input {
        input:        option<list<u8>>,
        user-profile: option<list<u8>>,
        context:      option<list<u8>>,
    }

    /// Score a private AI search audit intake and return a public-safe plan.
    /// Input and output are JSON bytes. The output never includes the private
    /// domain, contact email, internal notes, or budget.
    plan-audit: func(req: generic-input) -> result<list<u8>, string>;
}
